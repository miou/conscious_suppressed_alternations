# Data is distributed separately (not via git) and pointed to by set_paths.m.
# It is far too large for GitHub: data/sessions alone is ~1.5 TB, plus the
# HDF5 exports, Conor's state files, results, etc.
/data/*

# Generated figure outputs (regenerated by the figure scripts)
figures_output/

# MATLAB autosave / temporary files
*.asv
*.m~

# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db

# Logs written by python/scripts/run_pipeline.py
pipelines/*/logs/
