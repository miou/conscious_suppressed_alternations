# Data is distributed separately (not via git) and pointed to by set_paths.m — far too large for
# GitHub (data/sessions alone is ~1.5 TB raw, plus HDF5 exports, state files, results, etc.).
# Keep only the empty folder skeleton (the .gitkeep placeholders) so the expected layout is
# recreated on clone; ignore all actual data.
/data/**
!/data/**/
!/data/**/.gitkeep

# Generated figure outputs (regenerated by the figure scripts)
figures_output/

# MATLAB autosave / temporary files
*.asv
*.m~

# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db
